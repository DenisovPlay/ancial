!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & submodules / extra repos
/coverage
/AncBot
/DeployUbuntu
/FRAME-APP
/.agents

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI trash
/.qwen/

# backend / docs repos
/php-v2-api/
/docs/

# IDE & Editor files
.idea/
.vscode/
*.iml
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Android build & local files
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/app/src/main/res/xml/config.xml
*.apk
*.aab
*.dex

# iOS build & local files
/ios/App/build/
/ios/App/Pods/
/ios/App/output/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
/ios/DerivedData/
*.xcodeproj/**/xcuserdata/
